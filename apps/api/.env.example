JWT_REFRESH_EXPIRES_IN="7d"

# AI Integrations
OPENAI_API_KEY="sk-proj-your-openai-api-key-here"
GEMINI_API_KEY="your-gemini-api-key-here"

# CORS Allowed Origins
CORS_ORIGINS="http://localhost:5173"
