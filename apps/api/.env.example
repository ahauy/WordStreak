# Server Port
PORT=3000

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wordstreak?schema=public"

# JWT Authentication Secret
JWT_SECRET="super-secret-jwt-key-wordstreak-change-me"
JWT_EXPIRES_IN="15m"
