// Prisma Schema for WordStreak Backend

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String             @id @default(uuid())
  email        String             @unique
  passwordHash String
  username     String             @unique
  dailyGoal    Int                @default(10)
  avatarUrl    String?
  totalXp      Int                @default(0)
  level        Int                @default(1)
  tier         String             @default("BRONZE")
  preferredLanguage String          @default("vi")
  learningGoal      String?
  startingLevel     String?
  onboardingCompleted Boolean       @default(false)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  sessions     Session[]
  decks        Deck[]
  progress     UserCardProgress[]
  streaks      UserStreak[]
  reviewLogs   ReviewLog[]
  activityLogs UserActivityLog[]
  ratings      DeckRating[]
  deckEnrollments     UserDeckEnrollment[]
  officialProgress    UserOfficialCardProgress[]
  officialCardFeedbacks OfficialCardFeedback[]

  @@map("users")
}

model Session {
  id                 String    @id @default(uuid())
  userId             String
  hashedRefreshToken String
  userAgent          String?
  ipAddress          String?
  expiresAt          DateTime
  revokedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Deck {
  id            String       @id @default(uuid())
  userId        String
  title         String
  description   String?
  color         String       @default("#6366F1")
  icon          String       @default("Book")
  coverImageUrl String?
  category      String?
  tags          String?
  isPublic      Boolean      @default(false)
  isArchived    Boolean      @default(false)
  cloneCount    Int          @default(0)
  averageRating Float        @default(0.0)
  totalRatings  Int          @default(0)
  originalDeckId String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  cards         Card[]
  ratings       DeckRating[]
  sourceDeck    Deck?        @relation("DeckClones", fields: [originalDeckId], references: [id], onDelete: SetNull)
  clones        Deck[]       @relation("DeckClones")

  @@index([userId, isArchived])
  @@index([isPublic, isArchived, cloneCount])
  @@index([isPublic, isArchived, averageRating])
  @@index([category])
  @@map("decks")
}

model DeckRating {
  id        String   @id @default(uuid())
  deckId    String
  userId    String
  rating    Int
  comment   String?  @db.VarChar(500)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deck      Deck     @relation(fields: [deckId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([deckId, userId])
  @@index([deckId])
  @@index([userId])
  @@map("deck_ratings")
}

model Card {
  id              String             @id @default(uuid())
  deckId          String
  word            String
  meaning         String
  phonetic        String?
  audioUrl        String?
  exampleSentence String?
  collocations    String?
  mnemonic        String?
  imageUrl        String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  deck            Deck               @relation(fields: [deckId], references: [id], onDelete: Cascade)
  progress        UserCardProgress[]
  reviewLogs      ReviewLog[]

  @@map("cards")
}

model UserCardProgress {
  id             String    @id @default(uuid())
  userId         String
  cardId         String
  interval       Int       @default(0)
  easeFactor     Float     @default(2.5)
  repetitions    Int       @default(0)
  lastReviewedAt DateTime?
  nextReviewDate DateTime  @default(now())
  status         String    @default("NEW")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  card           Card      @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([userId, cardId])
  @@map("user_card_progress")
}

model UserStreak {
  id               String    @id @default(uuid())
  userId           String    @unique
  currentStreak    Int       @default(0)
  bestStreak       Int       @default(0)
  lastActiveDate   DateTime?
  streakFreezes    Int       @default(1)
  lastFreezeDate   DateTime?
  totalFreezesUsed Int       @default(0)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_streaks")
}

model GlobalDictionaryCache {
  id                 String   @id @default(uuid())
  word               String   @unique
  partOfSpeech       String?
  phonetic           String?
  meaningVi          String
  meaningEn          String?
  exampleSentence    String?
  exampleTranslation String?
  collocations       String?
  mnemonic           String?
  audioUrl           String?
  source             String   @default("GEMINI_FLASH")
  hitCount           Int      @default(1)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([word])
  @@map("global_dictionary_cache")
}

model ReviewLog {
  id         String   @id @default(uuid())
  userId     String
  cardId     String
  rating     Int      // 1: Again, 2: Hard, 3: Good, 4: Easy
  interval   Int      // New interval computed in days
  reviewedAt DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  card       Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([userId, reviewedAt])
  @@index([cardId])
  @@map("review_logs")
}

model UserActivityLog {
  id           String   @id @default(uuid())
  userId       String
  activityType String   // CARD_REVIEW | DAILY_GOAL_COMPLETED | STREAK_7_DAYS | STREAK_30_DAYS | PRACTICE_QUIZ | ADMIN_ADJUSTMENT | HISTORICAL_BACKFILL
  xpEarned     Int
  metadata     Json?    // e.g. { "cardId": "...", "rating": 3, "streakDays": 7, "localDate": "2026-08-21" }
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, activityType])
  @@index([userId, activityType, createdAt])
  @@index([createdAt])
  @@map("user_activity_logs")
}

// ==========================================
// OFFICIAL VOCABULARY & STARTER LIBRARY MODELS
// ==========================================

model WordList {
  id          String          @id @default(uuid())
  code        String          @unique // "TSL", "NGSL", "NAWL", "BSL"
  name        String                  // "TOEIC Service List"
  version     String                  // "1.2"
  license     String                  // "CC BY-SA 4.0"
  sourceUrl   String
  attribution String
  entryCount  Int
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  entries     WordListEntry[]

  @@map("word_lists")
}

model WordListEntry {
  id        String    @id @default(uuid())
  listId    String    @map("list_id")
  headword  String
  freqRank  Int?      @map("freq_rank")
  freqValue Float?    @map("freq_value")
  level     String?   // "T1", "T2", "T3"
  topic     String?
  cardId    String?   @map("card_id")

  wordList  WordList  @relation(fields: [listId], references: [id], onDelete: Cascade)
  card      OfficialCard? @relation(fields: [cardId], references: [id], onDelete: SetNull)

  @@unique([listId, headword])
  @@index([headword])
  @@map("word_list_entries")
}

model OfficialCard {
  id             String   @id @default(uuid())
  headword       String
  pos            String
  content        Json     // Conforms to OfficialCardContent JSON schema
  status         String   @default("DRAFT") // "DRAFT" | "REVIEWED" | "PUBLISHED"
  contentVersion Int      @default(1) @map("content_version")
  promptVersion  String?  @map("prompt_version")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  deckCards       OfficialDeckCard[]
  listEntries     WordListEntry[]
  userProgress    UserOfficialCardProgress[]
  feedbackReports OfficialCardFeedback[]

  @@index([headword])
  @@index([status])
  @@map("official_cards")
}

model OfficialDeck {
  id          String   @id @default(uuid())
  slug        String   @unique // "tsl-1a-office-operations"
  title       String
  titleVi     String   @map("title_vi")
  description String?
  pathCode    String   @map("path_code") // "TOEIC" | "CORE" | "FOUNDATION" | "ACADEMIC"
  level       String?  // "T1", "T2", "T3"
  order       Int      @default(0)
  listCode    String   @map("list_code") // "TSL", "NGSL"
  cardCount   Int      @default(25) @map("card_count")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cards       OfficialDeckCard[]
  enrollments UserDeckEnrollment[]

  @@index([pathCode, order])
  @@map("official_decks")
}

model OfficialDeckCard {
  deckId String @map("deck_id")
  cardId String @map("card_id")
  order  Int    @default(0)

  deck   OfficialDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  card   OfficialCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@id([deckId, cardId])
  @@map("official_deck_cards")
}

model UserDeckEnrollment {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  deckId        String    @map("deck_id")
  startedAt     DateTime  @default(now()) @map("started_at")
  lastStudiedAt DateTime? @map("last_studied_at")

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  deck          OfficialDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)

  @@unique([userId, deckId])
  @@index([userId])
  @@map("user_deck_enrollments")
}

model UserOfficialCardProgress {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  cardId         String    @map("card_id")

  // SuperMemo-2 SRS state
  repetitions    Int       @default(0)
  interval       Int       @default(0)     // Days until next review
  easeFactor     Float     @default(2.5)   @map("ease_factor")
  nextReviewDate DateTime? @map("next_review_date")
  lastReviewedAt DateTime? @map("last_reviewed_at")
  status         String    @default("NEW") // "NEW" | "LEARNING" | "MASTERED" | "KNOWN_SKIPPED"

  personalNote   String?   @map("personal_note")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  card           OfficialCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([userId, cardId])
  @@index([userId, nextReviewDate])
  @@index([userId, status])
  @@map("user_official_card_progress")
}

model OfficialCardFeedback {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  cardId    String   @map("card_id")
  reason    String   // "WRONG_MEANING" | "TYPO" | "AUDIO_ERROR" | "EXAMPLE_UNNATURAL" | "OTHER"
  comment   String?
  status    String   @default("OPEN") // "OPEN" | "RESOLVED" | "REJECTED"
  createdAt DateTime @default(now()) @map("created_at")

  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  card      OfficialCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("official_card_feedback")
}



