# Stage 1: Base & Build
FROM node:22-alpine AS builder

WORKDIR /app

# Cài đặt pnpm
RUN corepack enable && corepack prepare pnpm@11.21.0 --activate

# Copy toàn bộ file cấu hình workspace và package.json
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/shared-types/package.json ./packages/shared-types/
COPY apps/api/package.json ./apps/api/

# Cài đặt toàn bộ dependencies
RUN pnpm install --frozen-lockfile

# Copy mã nguồn các gói liên quan
COPY packages/shared-types ./packages/shared-types
COPY apps/api ./apps/api
COPY tsconfig.base.json ./

# Generate Prisma Client trước khi build
RUN pnpm --filter api prisma:generate

# Build package dùng chung trước, sau đó build API
RUN pnpm --filter @wordstreak/shared-types build
RUN pnpm --filter api build

# Stage 2: Production Runner
FROM node:22-alpine AS runner

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@11.21.0 --activate

ENV NODE_ENV=production

# Tạo non-root user vì mục đích bảo mật
RUN addgroup -g 1001 -S nodejs && adduser -S nestjs -u 1001

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/shared-types/package.json ./packages/shared-types/
COPY apps/api/package.json ./apps/api/

# Chỉ cài đặt production dependencies
RUN pnpm install --frozen-lockfile --prod

# Copy Prisma schema và generate Prisma Client cho production runtime
COPY apps/api/prisma ./apps/api/prisma
RUN pnpm --filter api prisma:generate

# Copy sản phẩm đã build từ stage builder
COPY --from=builder /app/packages/shared-types/dist ./packages/shared-types/dist
COPY --from=builder /app/apps/api/dist ./apps/api/dist

USER nestjs

EXPOSE 3000

CMD ["node", "apps/api/dist/src/main.js"]

