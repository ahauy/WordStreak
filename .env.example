# ==========================================
# WordStreak Monorepo Environment Variables
# ==========================================

# Environment Mode: development | production | test
NODE_ENV=development

# ------------------------------------------
# Database Configuration (PostgreSQL)
# ------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_DB=wordstreak_db
POSTGRES_PORT=5432
DATABASE_URL="postgresql://postgres:your_secure_postgres_password@localhost:5432/wordstreak_db?schema=public"

# ------------------------------------------
# Backend API (apps/api)
# ------------------------------------------
PORT=3000
JWT_SECRET="your-super-secret-jwt-access-key-min-32-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="your-super-secret-jwt-refresh-key-min-32-chars"
JWT_REFRESH_EXPIRES_IN="7d"
CLIENT_URL="http://localhost:5173"
CORS_ORIGINS="http://localhost:5173"

# ------------------------------------------
# AI Service Integrations (Optional)
# ------------------------------------------
OPENAI_API_KEY="sk-proj-your-openai-api-key-here"
GEMINI_API_KEY="your-gemini-api-key-here"

# ------------------------------------------
# Frontend Web (apps/web)
# ------------------------------------------
VITE_API_URL="http://localhost:3000"
VITE_HERO_VIDEO_URL=""
