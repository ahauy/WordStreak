{
  "name": "wordstreak-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev:api": "pnpm --filter api start:dev",
    "dev:web": "pnpm --filter web dev",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "test": "pnpm --filter @wordstreak/shared-types build && pnpm --filter api test && pnpm --filter web test",
    "seed:pipeline": "tsx scripts/seed/run-pipeline.ts"
  },
  "devDependencies": {
    "playwright": "^1.62.1",
    "tsx": "^4.23.15",
    "vitest": "^4.1.11"
  }
}
